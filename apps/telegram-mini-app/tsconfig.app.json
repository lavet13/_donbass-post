{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@donbass-post/typescript-config/vite.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "ymaps3": [
        "../../node_modules/@yandex/ymaps3-types"
      ],
      "js-cookie": [
        "../../node_modules/@types/js-cookie"
      ]
    },
    "typeRoots": [
      "../../node_modules/@types",
      "../../node_modules/@yandex/ymaps3-types"
    ],
    // no Vite installed here yet (src/ is a placeholder); replace with the shared
    // ["vite/client"] once the mini app gets its real Vite setup
    "types": []
  },
  "include": [
    "src/**/*"
  ],
}
